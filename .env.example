# Copy to .env.local (never committed). Both values are public by design: they end
# up in the browser bundle, and row level security is what protects the data.
# `npm run db:status` prints the local values (API URL and anon key).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=paste-the-local-anon-key-here
# Shows the one click login with the accounts of supabase/seed.sql. Never in production.
VITE_TEST_LOGIN=true
