{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rollstead",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    { "pattern": "rollstead.com.br", "custom_domain": true },
    { "pattern": "www.rollstead.com.br", "custom_domain": true },
  ],
  // The site itself is served only on the custom domains above
  "workers_dev": false,
  // Required for the pull request previews to get a *.workers.dev address
  "preview_urls": true,
  // Pull request previews (preview.yml). No production settings are inherited.
  "previews": {},
}
