{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rollstead",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    { "pattern": "rollstead.com.br", "custom_domain": true },
    { "pattern": "www.rollstead.com.br", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
}
